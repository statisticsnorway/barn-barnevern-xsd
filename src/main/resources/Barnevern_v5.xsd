                </xs:annotation>
            </xs:element>
            <xs:element name="ErSlettet" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation> </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Kode" type="HenvendelseKode" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Kategoriserer hvilken type henvendelse opplysningene gjelder</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Melder" type="MelderType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation> </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Saksinnhold" type="SaksinnholdKode" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Angivelse av tematikk i henvendelsen, og som danner grunnlaget for en bekymring omkring barnet eller for søknaden om bistand.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Konklusjon" type="HenvendelseKonklusjonType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>
