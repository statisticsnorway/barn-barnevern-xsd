    <!-- TYPEDEFINISJONER -->
    <xs:complexType name="AvgiverType">
        <xs:sequence>
            <xs:element name="Organisasjonsnummer" type="OrganisasjonsnummerType">
                <xs:annotation>
                    <xs:documentation>Unik ID som identifiserer rapporterende barnevernstjeneste</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Kommunenummer" type="KommunenummerType">
                <xs:annotation>
                    <xs:documentation>Nummeret til kommunen som har rapportert inn og som avgiveren (barnverntjenesten) representerer. Kommunenummeret er fastsatt iht. Statistisk sentralbyrås oversikt</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Kommunenavn" type="KommunenavnType">
                <xs:annotation>
                    <xs:documentation>Navnet til kommunen som har rapportert inn og som avgiveren (barnverntjenesten) representerer</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Bydelsnummer" type="BydelsnummerType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Innhentes (kun Oslo) for å identifisere hvilken barneverntjeneste individet er registrert i</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Bydelsnavn" type="BydelsnavnType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Bydelens navn</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
