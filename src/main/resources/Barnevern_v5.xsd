                </xs:annotation>
            </xs:element>
            <xs:element name="Krav" type="OversendelsePrivatKravType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Krav fra privat part om endring av tidligere vedtak fattet av fylkesnemnd.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Status" type="VedtakStatusType" maxOccurs="unbounded">
