<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="5.3.0">
    <!-- ROTELEMENT -->
    <xs:element name="BarnevernregisterInnrapportering" type="BarnevernregisterInnrapporteringType">
        <xs:annotation>
            <xs:documentation>
                Omsluttende element for rapportering av barnevernsdata.
            </xs:documentation>
        </xs:annotation>
    </xs:element>
    <!-- BARNEVERNTYPE -->
    <xs:complexType name="BarnevernregisterInnrapporteringType">
        <xs:sequence>
            <xs:element name="Id" type="UuidIdType">
                <xs:annotation>
                    <xs:documentation>Unik ID for innsendelse av datasett</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DatoUttrekk" type="DatoTidUttrekk">
                <xs:annotation>
                    <xs:documentation>Dato for uttrekk/innrapportering</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ForrigeId" type="UuidIdType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Unik ID som ble brukt ved forrige innrapportering. Muliggjør knytning av forrige innrapportering med siste innrapportering.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Fagsystem" type="FagsystemType">
                <xs:annotation>
                    <xs:documentation>Informasjon om fagsystem for innrapportering.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Avgiver" type="AvgiverType">
                <xs:annotation>
                    <xs:documentation>Informasjon om kommune for innrapportering.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Sak" type="SakType">
                <!-- unique-checks-->
                <xs:unique name="HenvendelseIdUnique">
                    <xs:selector xpath="Henvendelse"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="OversendelseFylkesnemndIdUnique">
                    <xs:selector xpath="OversendelseFylkesnemnd"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="VedtakIdUnique">
                    <xs:selector xpath="Vedtak"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="UndersokelseIdUnique">
                    <xs:selector xpath="Undersokelse"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="TiltakIdUnique">
                    <xs:selector xpath="Tiltak"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="PersonaliaIdUnique">
                    <xs:selector xpath="Personalia"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="PlanIdUnique">
                    <xs:selector xpath="Plan"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="FlyttingIdUnique">
                    <xs:selector xpath="Flytting"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="RelasjonIdUnique">
                    <xs:selector xpath="Relasjon"/>
                    <xs:field xpath="Id"/>
                </xs:unique>
                <xs:unique name="SlettetIdUnique">
                    <xs:selector xpath="Slettet"/>
                    <xs:field xpath="Id"/>
                    <xs:field xpath="Kode"/>
                </xs:unique>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <!-- PLAN -->
    <xs:complexType name="PlanType">
        <xs:sequence>
            <xs:element name="Id" type="UuidIdType"/>
            <xs:element name="MigrertId" type="MigrertIdType" minOccurs="0"/>
            <xs:element name="StartDato" type="xs:date">
                <xs:annotation>
                    <xs:documentation>Dato for tidspunkt planen regnes som aktiv.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ErSlettet" type="xs:boolean" minOccurs="0"/>
            <xs:element name="SluttDato" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Dato avslutning plan.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Kode" type="PlanKode"/>
        </xs:sequence>
    </xs:complexType>
    <!-- SAK -->
    <xs:complexType name="SakType">
        <xs:annotation>
            <xs:documentation>Typedefinisjon for Sak (tidligere Individ).Unik ID knyttet til en registrert sak i en barnevernstjeneste</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="id" type="UuidIdType">
                <xs:annotation>
                    <xs:documentation>ID-en er en flyktig GUID som endres fra tid til annen</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="MigrertId" type="MigrertIdType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Unik id knyttet til gammelt fagsystem. Identifiserer saken som en sak migrert fra gammelt fagsystem. Muliggjør en knytning av saken med data i det gamle systemet. Denne ID-en mister sin funksjon etter migrering.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="StartDato" type="xs:date">
                <xs:annotation>
                    <xs:documentation>Dato for når en ny sak opprettes på et barn i fagsystemet. Identifiserer datoen for når et individ får en ny sak registrert i fagsystemet</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="SluttDato" type="xs:date" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Dato for når en sak blir avsluttet/gjort inaktiv i fagsystemet. Identifiserer tidspunktet et individ er registrert ut av datasystemet.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Journalnummer" type="JournalnummerType">
                <xs:annotation>
                    <xs:documentation>Journalnummer knytter et individ til en sak i barnevernstjenestens arkiv, og følger barnet gjennom hele forløpet innenfor samme barnevernstjeneste. Journalnummer tilsvarer saksnummer/klientnummer. Hvis barnet flytter uten at saken blir overført til ny tjeneste, vil barnet få et nytt saksnummer ved ny registrering</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Avsluttet" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Saken er avsluttet. Angir om barnevernstjenesten har avsluttet saken.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ErSlettet" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Saken er slettet i fagsystemet</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="BrukAvPoliti" type="BrukAvPolitiType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Bruk av politi jf. §12-10</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="DatoIndividuellPlan" type="xs:date" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Dersom det opprettes en individuell plan for barnet, vil denne informajonen reflektere dato planen trer i kraft.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Personalia" type="PersonaliaType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Henvendelse" type="HenvendelseType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Tidligere melding</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Undersokelse" type="UndersokelseType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Plan" type="PlanType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Tiltak" type="TiltakType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Vedtak" type="VedtakType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Alle typer vedtak som kan fattes i barnevernssaker, også av fylkesnemnda.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="OversendelseFylkesnemnd" type="OversendelseBarneverntjenesteType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Begjæring om tvangsvedtak fra barneverntjeneste til fylkesnemnd.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Flytting" type="FlyttingType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="Relasjon" type="RelasjonType" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Kopling av elementer, f.eks. henvendelse/undersøkelse, tiltak/vedtak.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Slettet" type="SlettetType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <!-- HENVENDELSE -->
    <xs:complexType name="HenvendelseType">
        <xs:sequence>
            <xs:element name="Id" type="UuidIdType">
                <xs:annotation>
