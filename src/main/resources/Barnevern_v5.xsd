                12.8 = Miljøarbeid i hjemmet
                12.9 = Samtale med barnet/ungdommen/unge voksne
                12.10 = Samtalegrupper/barnegrupper
                12.11 = Utdanning/arbeid

                13. Samarbeidstiltak
                13.1 = Deltakelse i ansvarsgruppe
                13.2 = Samarbeidsmøter (m/ulike instanser)

                14. Nettverksmobiliserende tiltak
                14.1 = Familieråd
                14.2 = Nettverksmøter

                15. Opphold utenfor foreldrehjemmet
                15.1. Fosterhjem
                15.1.1 = Fosterhjem i familie og nære nettverk
                15.1.2 = Fosterhjem utenfor familie og nære nettverk
