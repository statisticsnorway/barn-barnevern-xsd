    <xs:complexType name="HenvendelseKonklusjonType">
        <xs:sequence>
            <xs:element name="Sluttdato" type="xs:date">
                <xs:annotation>
                    <xs:documentation>Dato for når meldingen eller søknaden konkluderes på av barnevernstjenesten. Denne datoen avslutter beregningen av tidsforløp for behandling av henvendelsen. Ved valg av konklusjon "2 - Ikke henlagt" blir datofeltet også startdato for den tilmålte tiden for gjennomføring av undersøkelse.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Kode" type="HenvendelseKonklusjonKode">
                <xs:annotation>
                    <xs:documentation>Kategorisering av barnevernstjenestens konklusjon etter gjennomgang av melding eller søknad. Denne settes når henvendelsen er ferdig behandlet og tjenestens videre forløp i saken er besluttet.</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="FagsystemType">
        <xs:sequence>
            <xs:element name="Leverandor" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Leverandør av fagsystemet som er kilde til dataene</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Navn" type="xs:string">
