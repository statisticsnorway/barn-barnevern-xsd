                    <xs:documentation>Tilsyn i fosterhjem utført av uavhengig part.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Oppfolging" type="OppfolgingType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Oppfølgingsbesøk i fosterhjem utført av ansvarlig barneverntjeneste.</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="Konklusjon" type="TiltakKonklusjonType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation> </xs:documentation>
                </xs:annotation>
            </xs:element>
